# Environment
NODE_ENV=development

# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
TARGET_GROUP_ID=your_telegram_group_id_here

# Solana Configuration
HELIUS_API_KEY=your_helius_api_key_here
DEV_KEYPAIR=your_base58_encoded_keypair_here
TOKEN_MINT=your_token_mint_address_here
BUYBACK_PERCENT=0.05

# X (Twitter) Configuration
X_API_KEY=your_x_api_key_here
X_API_SECRET_KEY=your_x_api_secret_key_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here
X_RAPIDAPI_KEY=your_rapidapi_key_here
X_TARGET_USERNAME=your_x_username_here

# Database Configuration
MONGODB_URI=mongodb://root:example@localhost:27017
DB_NAME=raid-bot

# Resource Path
RESOURCE_PATH=./resources

# Raid Configuration - Timing (in seconds)
RAID_CHECK_INTERVAL=15
RAID_TIMEOUT=600
RAID_START_INTERVAL=600
RAID_MAX_INTERVAL=1800
RAID_MIN_INTERVAL=300

# Raid Configuration - Scalars
RAID_INTERVAL_SCALAR=1.25
RAID_METRICS_SCALAR=1.25

# Raid Configuration - Starting Metrics
RAID_START_LIKES=6
RAID_START_RETWEETS=2
RAID_START_REPLIES=1
RAID_START_BOOKMARKS=4

# Raid Configuration - Minimum Metrics
RAID_MIN_LIKES=3
RAID_MIN_RETWEETS=1
RAID_MIN_REPLIES=1
RAID_MIN_BOOKMARKS=2

# Raid Configuration - Maximum Metrics
RAID_MAX_LIKES=28
RAID_MAX_RETWEETS=5
RAID_MAX_REPLIES=19
RAID_MAX_BOOKMARKS=15
